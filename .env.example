# ==============================================================================
# Jain Sarafa Thella E-Commerce Platform — Environment Variables Template
# File: .env.example
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env.local' for local development or set in Vercel/Hosting dashboard.
# 2. NEVER commit '.env.local', '.env.production', or real secret keys to Git.
# 3. All placeholder values below must be replaced with verified credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & DEPLOYMENT RUNTIME
# ------------------------------------------------------------------------------
NODE_ENV="development"
PORT=3000
# Canonical site URL (do not include trailing slash)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Default locale: hi-IN (Hindi), alternative: en-IN
NEXT_PUBLIC_DEFAULT_LOCALE="hi-IN"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SESSION SECURITY (NextAuth / JWT)
# ------------------------------------------------------------------------------
# In production, generate a secure random 32-byte secret using: openssl rand -base64 32
NEXTAUTH_SECRET="your-32-character-random-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"
# Session duration in seconds (e.g., 30 days = 2592000)
SESSION_MAX_AGE_SECONDS=2592000
# Mobile OTP expiration in seconds (default: 5 minutes = 300)
OTP_EXPIRY_SECONDS=300

# ------------------------------------------------------------------------------
# 3. DATABASE INFRASTRUCTURE (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# Transaction connection string (with connection pooling, e.g., Supabase / PgBouncer port 6543)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?sslmode=require"
# Direct connection string (port 5432) for running migrations
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# Supabase API credentials (if utilizing Supabase managed Auth/Storage/Realtime)
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here"
# Service role key with administrative privileges (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here"

# ------------------------------------------------------------------------------
# 4. PRIVATE OBJECT STORAGE (Artwork Uploads, Invoices & Labels)
# ------------------------------------------------------------------------------
# Provider: 'supabase' | 'r2' | 's3'
STORAGE_PROVIDER="supabase"
STORAGE_BUCKET_PRIVATE="jst-private-assets"
STORAGE_BUCKET_PUBLIC="jst-public-catalog"
# Required if utilizing Cloudflare R2 or AWS S3:
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_REGION="ap-south-1"

# ------------------------------------------------------------------------------
# 5. PAYMENT GATEWAY (Razorpay India)
# ------------------------------------------------------------------------------
# Public Key ID for Razorpay Checkout JS modal (Safe for client)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_YourKeyIdHere"
# Razorpay Key Secret for server-side order creation (SERVER-SIDE ONLY)
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"
# Webhook Secret configured in Razorpay Dashboard for HMAC-SHA256 signature verification
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_here"

# ------------------------------------------------------------------------------
# 6. LOGISTICS & COURIER AGGREGATOR (Shiprocket)
# ------------------------------------------------------------------------------
# Shiprocket merchant account credentials for token generation (/auth/login)
SHIPROCKET_EMAIL="logistics@jainsarafathella.com"
SHIPROCKET_PASSWORD="your_shiprocket_password_here"
SHIPROCKET_BASE_URL="https://apiv2.shiprocket.in/v1/external"
# Agra physical warehouse pickup postal pincode
SHIPROCKET_PICKUP_PINCODE="282001"
# Secret token to authenticate incoming tracking webhooks from Shiprocket
SHIPROCKET_WEBHOOK_TOKEN="your_custom_shiprocket_webhook_secret_token"

# ------------------------------------------------------------------------------
# 7. OFFICIAL WHATSAPP BUSINESS PLATFORM (Meta Cloud API)
# ------------------------------------------------------------------------------
# Phone number ID from Meta App Dashboard
WHATSAPP_PHONE_NUMBER_ID="your_meta_phone_number_id_here"
# WhatsApp Business Account ID (WABA ID)
WHATSAPP_BUSINESS_ACCOUNT_ID="your_meta_waba_id_here"
# Permanent System User Access Token with 'whatsapp_business_messaging' permissions
WHATSAPP_ACCESS_TOKEN="EAAxxxxxxx_your_permanent_access_token_here"
# Random string configured in Meta Webhooks for initial verification handshake
WHATSAPP_WEBHOOK_VERIFY_TOKEN="your_custom_webhook_verify_handshake_token"
# Meta App Secret for validating incoming webhook SHA256 signatures
WHATSAPP_APP_SECRET="your_meta_app_secret_here"

# ------------------------------------------------------------------------------
# 8. BUSINESS COMPLIANCE & STATUTORY DETAILS (India E-Commerce Disclosures)
# ------------------------------------------------------------------------------
BUSINESS_LEGAL_NAME="Jain Sarafa Thella"
BUSINESS_TRADE_NAME="Jain Sarafa Thella"
# Uttar Pradesh GST State Code: 09
BUSINESS_STATE_CODE="09"
# 15-character GSTIN (Subject to Chartered Accountant verification under DEC-07)
BUSINESS_GSTIN="09XXXXXXXXXXZX"
BUSINESS_PAN="XXXXXXXXXX"
BUSINESS_ADDRESS_LINE1="Sarafa Bazar, Chowk"
BUSINESS_CITY="Agra"
BUSINESS_STATE="Uttar Pradesh"
BUSINESS_PINCODE="282001"
BUSINESS_SUPPORT_PHONE="+91XXXXXXXXXX"
BUSINESS_SUPPORT_EMAIL="support@jainsarafathella.com"

# Consumer Protection (E-Commerce) Rules, 2020: Grievance Redressal Officer
GRIEVANCE_OFFICER_NAME="Grievance Officer Name"
GRIEVANCE_OFFICER_DESIGNATION="Nodal Compliance & Grievance Officer"
GRIEVANCE_OFFICER_EMAIL="grievance@jainsarafathella.com"
GRIEVANCE_OFFICER_PHONE="+91XXXXXXXXXX"

# ------------------------------------------------------------------------------
# 9. PROVISIONAL POLICY PLACEHOLDERS (Governed by Pending Decisions DEC-01 to DEC-06)
# Note: These values will be overridden once the business owner formally signs off.
# ------------------------------------------------------------------------------
# DEC-01: Is guest checkout enabled? ('true' or 'false')
NEXT_PUBLIC_ENABLE_GUEST_CHECKOUT="false"
# DEC-02: Retail COD Min/Max thresholds and surcharge in INR
COD_MIN_CART_VALUE=499
COD_MAX_CART_VALUE=3000
COD_HANDLING_SURCHARGE=49
# DEC-03: Inventory soft-reservation lock duration in minutes
INVENTORY_RESERVATION_TIMEOUT_MINUTES=15
